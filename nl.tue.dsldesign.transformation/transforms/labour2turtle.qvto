modeltype LaBouR uses "http://www.example.org/laBouR"; 
modeltype Turtle uses "http://www.example.org/turtle";

transformation labour2turtle(in source: LaBouR, out target: Turtle);

main() {
    source.rootObjects()[BoulderingWall]->map wall2Program();
}

mapping BoulderingWall::wall2Program() : Turtle::Program {
    self.route->forEach(r) {
        r->map routeToStatements(result);
    };
}

mapping LaBouR::Route::routeToStatements(inout prog : Turtle::Program) {
    var commonHolds := self.steps->select(oclIsTypeOf(LaBouR::SingleStep))
                                 .oclAsType(LaBouR::SingleStep).hold;
    
    var splitStep := self.steps->select(oclIsTypeOf(LaBouR::SplitStep))
                                 .oclAsType(LaBouR::SplitStep)->any(true);

    var path1Holds := commonHolds->asSequence();
    if (splitStep <> null) then path1Holds += splitStep.left endif;
    var sortedPath1 := path1Holds->sortedBy(h | h.pos.y);
    
    self.generatePathInstructions(prog, sortedPath1);

    if (splitStep <> null) then {
        var path2Holds := commonHolds->asSequence();
        path2Holds += splitStep.right;
        var sortedPath2 := path2Holds->sortedBy(h | h.pos.y);
        
        self.generatePathInstructions(prog, sortedPath2);
    } endif;
}

helper LaBouR::Route::generatePathInstructions(inout prog : Turtle::Program, sortedHolds : Sequence(LaBouR::Hold)) {
    var curX := self.gridbasepointer.x;
    var curY := self.gridbasepointer.y;
    
    sortedHolds->forEach(h) {
        var nX := h.pos.x;
        var nY := h.pos.y;
        
        prog.statements += object Turtle::TurnToZero {};
        
        if (nX >= curX) then {
            prog.statements += object Turtle::TurnRight { 
                expr := createAngleExpr(curX, curY, nX, nY) 
            };
        } else {
            prog.statements += object Turtle::TurnLeft { 
                expr := createAngleExpr(nX, curY, curX, nY) 
            };
        } endif;
        
        prog.statements += object Turtle::Move { 
            expr := createDistanceExpr(curX, curY, nX, nY) 
        };
        
        curX := nX;
        curY := nY;
    }
}

query createReal(v : Real) : Turtle::RealConst {
    return object Turtle::RealConst { value := v; };
}

query createSqrDiff(val1 : Integer, val2 : Integer) : Turtle::Sqr {
    return object Turtle::Sqr {
        expr := object Turtle::Binary {
            left := createReal(val1);
            right := createReal(val2);
            operation := Turtle::Operation::SUBTRACT;
        };
    };
}

query createDistanceExpr(x1: Integer, y1: Integer, x2: Integer, y2: Integer) : Turtle::Sqrt {
    return object Turtle::Sqrt {
        expr := object Turtle::Binary {
            left := createSqrDiff(x2, x1);
            right := createSqrDiff(y2, y1);
            operation := Turtle::Operation::ADD;
        };
    };
}

query createAngleExpr(x1: Integer, y1: Integer, x2: Integer, y2: Integer) : Turtle::Arctan {
    return object Turtle::Arctan {
        expr := object Turtle::Binary {
            left := object Turtle::Binary {
                left := createReal(x2);
                right := createReal(x1);
                operation := Turtle::Operation::SUBTRACT;
            };
            right := object Turtle::Binary {
                left := createReal(y2);
                right := createReal(y1);
                operation := Turtle::Operation::SUBTRACT;
            };
            operation := Turtle::Operation::DIVISION;
        };
    };
}