<?xml version="1.0" encoding="UTF-8"?>
<turtle:Program xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:turtle="http://www.example.org/turtle" xsi:schemaLocation="http://www.example.org/turtle ../nl.tue.dsldesign.turtle/model/turtle.ecore">
  <statements xsi:type="turtle:TurnToZero"/>
  <statements xsi:type="turtle:TurnLeft">
    <expr xsi:type="turtle:Arctan">
      <expr xsi:type="turtle:Binary" operation="DIVISION">
        <left xsi:type="turtle:Binary" operation="SUBTRACT">
          <left xsi:type="turtle:RealConst" value="30.0"/>
          <right xsi:type="turtle:RealConst" value="10.0"/>
        </left>
        <right xsi:type="turtle:Binary" operation="SUBTRACT">
          <left xsi:type="turtle:RealConst" value="70.0"/>
          <right xsi:type="turtle:RealConst" value="20.0"/>
        </right>
      </expr>
    </expr>
  </statements>
  <statements xsi:type="turtle:Move">
    <expr xsi:type="turtle:Sqrt">
      <expr xsi:type="turtle:Binary" operation="ADD">
        <left xsi:type="turtle:Sqr">
          <expr xsi:type="turtle:Binary" operation="SUBTRACT">
            <left xsi:type="turtle:RealConst" value="10.0"/>
            <right xsi:type="turtle:RealConst" value="30.0"/>
          </expr>
        </left>
        <right xsi:type="turtle:Sqr">
          <expr xsi:type="turtle:Binary" operation="SUBTRACT">
            <left xsi:type="turtle:RealConst" value="70.0"/>
            <right xsi:type="turtle:RealConst" value="20.0"/>
          </expr>
        </right>
      </expr>
    </expr>
  </statements>
  <statements xsi:type="turtle:TurnToZero"/>
  <statements xsi:type="turtle:TurnRight">
    <expr xsi:type="turtle:Arctan">
      <expr xsi:type="turtle:Binary" operation="DIVISION">
        <left xsi:type="turtle:Binary" operation="SUBTRACT">
          <left xsi:type="turtle:RealConst" value="40.0"/>
          <right xsi:type="turtle:RealConst" value="10.0"/>
        </left>
        <right xsi:type="turtle:Binary" operation="SUBTRACT">
          <left xsi:type="turtle:RealConst" value="100.0"/>
          <right xsi:type="turtle:RealConst" value="70.0"/>
        </right>
      </expr>
    </expr>
  </statements>
  <statements xsi:type="turtle:Move">
    <expr xsi:type="turtle:Sqrt">
      <expr xsi:type="turtle:Binary" operation="ADD">
        <left xsi:type="turtle:Sqr">
          <expr xsi:type="turtle:Binary" operation="SUBTRACT">
            <left xsi:type="turtle:RealConst" value="40.0"/>
            <right xsi:type="turtle:RealConst" value="10.0"/>
          </expr>
        </left>
        <right xsi:type="turtle:Sqr">
          <expr xsi:type="turtle:Binary" operation="SUBTRACT">
            <left xsi:type="turtle:RealConst" value="100.0"/>
            <right xsi:type="turtle:RealConst" value="70.0"/>
          </expr>
        </right>
      </expr>
    </expr>
  </statements>
  <statements xsi:type="turtle:TurnToZero"/>
  <statements xsi:type="turtle:TurnRight">
    <expr xsi:type="turtle:Arctan">
      <expr xsi:type="turtle:Binary" operation="DIVISION">
        <left xsi:type="turtle:Binary" operation="SUBTRACT">
          <left xsi:type="turtle:RealConst" value="60.0"/>
          <right xsi:type="turtle:RealConst" value="40.0"/>
        </left>
        <right xsi:type="turtle:Binary" operation="SUBTRACT">
          <left xsi:type="turtle:RealConst" value="140.0"/>
          <right xsi:type="turtle:RealConst" value="100.0"/>
        </right>
      </expr>
    </expr>
  </statements>
  <statements xsi:type="turtle:Move">
    <expr xsi:type="turtle:Sqrt">
      <expr xsi:type="turtle:Binary" operation="ADD">
        <left xsi:type="turtle:Sqr">
          <expr xsi:type="turtle:Binary" operation="SUBTRACT">
            <left xsi:type="turtle:RealConst" value="60.0"/>
            <right xsi:type="turtle:RealConst" value="40.0"/>
          </expr>
        </left>
        <right xsi:type="turtle:Sqr">
          <expr xsi:type="turtle:Binary" operation="SUBTRACT">
            <left xsi:type="turtle:RealConst" value="140.0"/>
            <right xsi:type="turtle:RealConst" value="100.0"/>
          </expr>
        </right>
      </expr>
    </expr>
  </statements>
  <statements xsi:type="turtle:TurnToZero"/>
  <statements xsi:type="turtle:TurnRight">
    <expr xsi:type="turtle:Arctan">
      <expr xsi:type="turtle:Binary" operation="DIVISION">
        <left xsi:type="turtle:Binary" operation="SUBTRACT">
          <left xsi:type="turtle:RealConst" value="30.0"/>
          <right xsi:type="turtle:RealConst" value="30.0"/>
        </left>
        <right xsi:type="turtle:Binary" operation="SUBTRACT">
          <left xsi:type="turtle:RealConst" value="60.0"/>
          <right xsi:type="turtle:RealConst" value="20.0"/>
        </right>
      </expr>
    </expr>
  </statements>
  <statements xsi:type="turtle:Move">
    <expr xsi:type="turtle:Sqrt">
      <expr xsi:type="turtle:Binary" operation="ADD">
        <left xsi:type="turtle:Sqr">
          <expr xsi:type="turtle:Binary" operation="SUBTRACT">
            <left xsi:type="turtle:RealConst" value="30.0"/>
            <right xsi:type="turtle:RealConst" value="30.0"/>
          </expr>
        </left>
        <right xsi:type="turtle:Sqr">
          <expr xsi:type="turtle:Binary" operation="SUBTRACT">
            <left xsi:type="turtle:RealConst" value="60.0"/>
            <right xsi:type="turtle:RealConst" value="20.0"/>
          </expr>
        </right>
      </expr>
    </expr>
  </statements>
  <statements xsi:type="turtle:TurnToZero"/>
  <statements xsi:type="turtle:TurnRight">
    <expr xsi:type="turtle:Arctan">
      <expr xsi:type="turtle:Binary" operation="DIVISION">
        <left xsi:type="turtle:Binary" operation="SUBTRACT">
          <left xsi:type="turtle:RealConst" value="40.0"/>
          <right xsi:type="turtle:RealConst" value="30.0"/>
        </left>
        <right xsi:type="turtle:Binary" operation="SUBTRACT">
          <left xsi:type="turtle:RealConst" value="100.0"/>
          <right xsi:type="turtle:RealConst" value="60.0"/>
        </right>
      </expr>
    </expr>
  </statements>
  <statements xsi:type="turtle:Move">
    <expr xsi:type="turtle:Sqrt">
      <expr xsi:type="turtle:Binary" operation="ADD">
        <left xsi:type="turtle:Sqr">
          <expr xsi:type="turtle:Binary" operation="SUBTRACT">
            <left xsi:type="turtle:RealConst" value="40.0"/>
            <right xsi:type="turtle:RealConst" value="30.0"/>
          </expr>
        </left>
        <right xsi:type="turtle:Sqr">
          <expr xsi:type="turtle:Binary" operation="SUBTRACT">
            <left xsi:type="turtle:RealConst" value="100.0"/>
            <right xsi:type="turtle:RealConst" value="60.0"/>
          </expr>
        </right>
      </expr>
    </expr>
  </statements>
  <statements xsi:type="turtle:TurnToZero"/>
  <statements xsi:type="turtle:TurnRight">
    <expr xsi:type="turtle:Arctan">
      <expr xsi:type="turtle:Binary" operation="DIVISION">
        <left xsi:type="turtle:Binary" operation="SUBTRACT">
          <left xsi:type="turtle:RealConst" value="60.0"/>
          <right xsi:type="turtle:RealConst" value="40.0"/>
        </left>
        <right xsi:type="turtle:Binary" operation="SUBTRACT">
          <left xsi:type="turtle:RealConst" value="140.0"/>
          <right xsi:type="turtle:RealConst" value="100.0"/>
        </right>
      </expr>
    </expr>
  </statements>
  <statements xsi:type="turtle:Move">
    <expr xsi:type="turtle:Sqrt">
      <expr xsi:type="turtle:Binary" operation="ADD">
        <left xsi:type="turtle:Sqr">
          <expr xsi:type="turtle:Binary" operation="SUBTRACT">
            <left xsi:type="turtle:RealConst" value="60.0"/>
            <right xsi:type="turtle:RealConst" value="40.0"/>
          </expr>
        </left>
        <right xsi:type="turtle:Sqr">
          <expr xsi:type="turtle:Binary" operation="SUBTRACT">
            <left xsi:type="turtle:RealConst" value="140.0"/>
            <right xsi:type="turtle:RealConst" value="100.0"/>
          </expr>
        </right>
      </expr>
    </expr>
  </statements>
</turtle:Program>
